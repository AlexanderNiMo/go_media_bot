# Copy to .env and fill in. Read by docker compose, not by the application —
# the application reads MEDIAD_* variables (see config.yaml / README).

# --- required -------------------------------------------------------------

# Superuser of the Postgres container. Owns the two Temporal databases.
POSTGRES_PASSWORD=change-me-temporal

# Password for the application's own `mediad` database and role.
MEDIAD_DB_PASSWORD=change-me-mediad

# --- optional -------------------------------------------------------------

TEMPORAL_NAMESPACE=mediad

# Full DSN for the application database, used by `make psql` and when running
# the binary on the host rather than in compose.
MEDIAD_POSTGRES_DSN=postgres://mediad:change-me-mediad@localhost:5432/mediad?sslmode=disable

# https://www.themoviedb.org/settings/api — the v3 API key or a v4 read token.
TMDB_API_KEY=

# Optional HTTP proxy for TMDB, if the API is not reachable directly. Both the
# API calls and the posters go through it: the browser is never sent to
# image.tmdb.org, it asks our own /poster/ endpoint, so the proxy is the only
# way out and one setting covers everything.
#
# TMDB_PROXY=http://192.168.1.10:3128
TMDB_PROXY=

# Plex. The token is X-Plex-Token; see the README for how to find it.
#
# The values below are read by a process running on the host, which is what
# `make worker` and `make api` are. `make up-all` runs the application inside a
# container instead, where localhost means the container itself, so it needs the
# *_DOCKER variants further down. Uncomment those only if your services are not
# on the machine running Docker.
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Prowlarr, Jackett, or any Torznab endpoint. `indexer.mode` picks the client;
# when unset the application uses Jackett. `INDEXER_BASE_URL` is the front end's
# own root — for Jackett that is the host (e.g. http://localhost:9118), not the
# full aggregate path, which the client builds.
INDEXER_BASE_URL=http://localhost:9118
INDEXER_API_KEY=

QBITTORRENT_URL=http://localhost:8080
# Preferred on qBittorrent 5.1 and newer: no login request is made at all,
# which also avoids the IP ban that repeated failed logins earn.
QBITTORRENT_API_KEY=
# Used only when no API key is set.
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# Telegram bot token from @BotFather. Setting it turns the bot on; leaving it
# empty leaves the bot quiet, and everything else runs the same.
TELEGRAM_TOKEN=

# --- for `make up-all` only -------------------------------------------------

# The application in a container reaches the host through host.docker.internal,
# which compose maps to the host gateway. These override the values above, and
# only for that container — so the same .env works for both ways of running.
#
# Leave them commented out when the services really are on the Docker host:
# uncommenting a line that points at the wrong place is worse than leaving it
# alone, because the resulting error is a connection refused that looks like
# the service is down.
#
# PLEX_URL_DOCKER=http://host.docker.internal:32400
# INDEXER_BASE_URL_DOCKER=http://host.docker.internal:9696
# QBITTORRENT_URL_DOCKER=http://host.docker.internal:8080
