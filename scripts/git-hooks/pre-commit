#!/bin/sh
# Check the staged tree without changing the index or working files.
# Install with `make install-hooks` after pulling changes to this file.
set -eu
umask 077

cd "$(git rev-parse --show-toplevel)"
check_dir=$(mktemp -d "${TMPDIR:-/tmp}/mediad-pre-commit.XXXXXX")
trap 'rm -rf "$check_dir"' EXIT
trap 'exit 1' HUP INT TERM

git checkout-index --all --prefix="$check_dir/"
# .env is ignored, but the local checks need the same connection settings.
if [ -f .env ]; then
    cp .env "$check_dir/.env"
fi

# An explicitly supplied test database needs no local Docker setup.
if [ -z "${MEDIAD_TEST_DSN:-}" ]; then
    echo "→ make test-db-setup"
    make test-db-setup
fi

# Git's hook environment must not redirect commands in the snapshot back here.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
cd "$check_dir"
echo "→ make check-ci (staged files)"
make check-ci

echo "pre-commit checks passed"
