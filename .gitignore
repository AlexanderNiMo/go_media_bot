# Postgres data. Bind-mounted rather than a named volume so it is visible and
# rsync-able; it is data, not part of the repository.
/data/

# Local configuration and secrets. config.yaml is optional — the binary runs on
# defaults — but when present it is machine-specific.
.env
config.yaml
# config_dev.yaml.example is the committed template; the real config_dev.yaml
# is the per-developer override and is not for the repository.
config_dev.yaml

bin/
*.test
*.out
coverage.*

.DS_Store
.idea/
.vscode/
.zed/
__debug_bin*

# Agent settings local to this machine. Shared configuration, if any is ever
# needed, belongs in .claude/settings.json instead.
.claude/settings.local.json
