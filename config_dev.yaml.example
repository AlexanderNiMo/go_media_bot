# Dev overrides for `mediad`. Loaded on top of defaults and config.yaml when
# no --config flag is given, and overridden in turn by MEDIAD_* env vars.
#
# Real file: config_dev.yaml — in .gitignore, copy of this one. That way each
# developer can tweak the local settings without touching the committed file.
#
# Sections that are not in your config.yaml or this file keep their compiled-in
# defaults. Add a key only when you mean to override it.

log:
  level: debug
  format: text

# Local services. These match the values in .zed/debug.json, so a developer's
# in-process worker (mediad worker) and the Docker stack agree on the same
# hosts.
server:
  base_url: http://localhost:8081
  # base_path: /mediad

postgres:
  # `mediad_dev` is a separate database; the test suite creates and drops
  # its own throwaway databases, but development traffic should not share
  # that lifecycle.
  dsn: postgres://mediad:devpass@localhost:5432/mediad?sslmode=disable
  max_conns: 5

temporal:
  host: localhost:7233
  namespace: mediad
  task_queue: mediad

# Plex on the home network.
plex:
  url: http://192.168.1.107:32400
  token: ""

# Prowlarr aggregates every configured tracker. Empty token would still
# work for unauthenticated endpoints, but Prowlarr requires the key.
indexer:
  mode: prowlarr
  base_url: http://192.168.1.107:9696
  api_key: ""

# qBittorrent on the home network. The port is the Web UI port, not the
# listen port.
qbittorrent:
  url: http://192.168.1.107:8113
  api_key: ""

# Telegram is off during dev: a developer who has set TELEGRAM_TOKEN for
# another project can use this to suppress the bot.
telegram:
  enabled: false

# The point of a dev profile: stages that take days in production take
# minutes here.
search:
  search_deadline: 30m
  backoff_ladder: [10s, 20s, 40s, 80s, 160s, 320s]
  jitter: 1s
  poll_interval: 5s
  continue_as_new_history: 200

download:
  deadline: 1m
  zero_stall_after: 10s
  missing_grace: 5s
  max_stalls: 2

quality:
  russian_audio: false
  min_seeders: 1
  min_size_gb: 0.1
  max_size_gb: 200
